artifacts/subset_predictions.json
artifacts/tflite_predictions.json
artifacts/onnx_io.json
artifacts/tflite_io.json
artifacts/onnx2tf_*
artifacts/smoke/

# conversion venv (TensorFlow has no stable wheel for the Windows python 3.14 here)
.venv*/

__pycache__/
