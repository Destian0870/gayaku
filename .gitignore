# Local training data, kept out of the repository: 15 folders, 7,500 photographs, ~1.4 GB.
# The training notebook reads this dataset as a Kaggle input, so no checkout needs it.
# See docs/adr/0007-carousell-clothes-dataset.md.
Clothes_Dataset/
# Ultralytics downloads its checkpoints into the working directory when a script runs from
# the repository root (ml_workspace/yolo/.gitignore already covers the ones inside yolo/).
yolov8*.pt
/runs/
